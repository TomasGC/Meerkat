{
  "skip_dirs": [
    ".git", ".svn", "node_modules", "vendor", "bin", "obj", "dist", "build",
    "out", "target", "coverage", ".nyc_output", "__pycache__", ".pytest_cache",
    ".venv", "venv", ".tox", "eggs", ".eggs"
  ],
  "languages": {
    "python":     { "extensions": [".py"], "comment_style": "hash", "has_classes": true,
                    "standards": null, "build": null, "test": "python -m pytest", "format": "black ." },
    "typescript": { "extensions": [".ts", ".tsx"], "comment_style": "slash", "has_classes": true,
                    "standards": "rules/standards-typescript.md", "build": "npm run build", "test": "npm test", "format": "npx prettier --write ." },
    "javascript": { "extensions": [".js", ".jsx", ".mjs", ".cjs"], "comment_style": "slash", "has_classes": true,
                    "standards": "rules/standards-javascript.md", "build": "npm run build", "test": "npm test", "format": "npx prettier --write ." },
    "vue":        { "extensions": [".vue"], "comment_style": "slash", "has_classes": false,
                    "standards": "rules/standards-vuejs3.md", "build": "npm run build", "test": "npm test", "format": "npx prettier --write ." },
    "csharp":     { "extensions": [".cs"], "comment_style": "slash", "has_classes": true,
                    "standards": null, "build": "dotnet build", "test": "dotnet test", "format": "dotnet format" },
    "razor":      { "extensions": [".cshtml", ".razor"], "comment_style": "slash", "has_classes": false,
                    "standards": "rules/standards-cshtml.md", "build": "dotnet build", "test": null, "format": "dotnet format" },
    "go":         { "extensions": [".go"], "comment_style": "slash", "has_classes": false,
                    "standards": null, "build": "go build ./...", "test": "go test ./...", "format": "gofmt -w ." },
    "java":       { "extensions": [".java"], "comment_style": "slash", "has_classes": true,
                    "standards": null, "build": "mvn compile", "test": "mvn test", "format": null },
    "kotlin":     { "extensions": [".kt", ".kts"], "comment_style": "slash", "has_classes": true,
                    "standards": null, "build": "gradle build", "test": "gradle test", "format": null },
    "swift":      { "extensions": [".swift"], "comment_style": "slash", "has_classes": true,
                    "standards": null, "build": "swift build", "test": "swift test", "format": null },
    "rust":       { "extensions": [".rs"], "comment_style": "slash", "has_classes": true,
                    "standards": null, "build": "cargo build", "test": "cargo test", "format": "cargo fmt" },
    "ruby":       { "extensions": [".rb"], "comment_style": "hash", "has_classes": true,
                    "standards": null, "build": null, "test": "bundle exec rspec", "format": null },
    "cpp":        { "extensions": [".cpp", ".cc", ".cxx", ".hpp"], "comment_style": "slash", "has_classes": true,
                    "standards": null, "build": "cmake --build .", "test": "ctest", "format": "clang-format -i" },
    "php":        { "extensions": [".php"], "comment_style": "slash", "has_classes": true,
                    "standards": null, "build": null, "test": "vendor/bin/phpunit", "format": null },
    "perl":       { "extensions": [".pl", ".pm"], "comment_style": "hash", "has_classes": false,
                    "standards": null, "build": null, "test": "prove -r t", "format": null },
    "powershell": { "extensions": [".ps1", ".psm1", ".psd1"], "comment_style": "hash", "has_classes": true,
                    "standards": "rules/standards-powershell.md", "build": null, "test": "Invoke-Pester", "format": null },
    "bash":       { "extensions": [".sh", ".bash"], "comment_style": "hash", "has_classes": false,
                    "standards": "rules/standards-bash.md", "build": null, "test": "bats .", "format": "shfmt -w ." },
    "sql":        { "extensions": [".sql"], "comment_style": "dash", "has_classes": false,
                    "standards": null, "build": null, "test": null, "format": null },
    "yaml":       { "extensions": [".yaml", ".yml"], "comment_style": "hash", "has_classes": false,
                    "standards": null, "build": null, "test": null, "format": null },
    "dockerfile": { "extensions": [], "filename_pattern": "^[Dd]ockerfile(\\.\\w+)?$", "comment_style": "hash", "has_classes": false,
                    "standards": "rules/standards-docker.md", "build": "docker build .", "test": null, "format": null }
  },
  "dialects": {
    "sql": {
      "mssql":      { "patterns": ["(?mi)^\\s*GO\\s*$", "(?i)\\bNVARCHAR\\b", "(?i)\\[dbo\\]\\."],
                      "standards": "rules/standards-sqlserver.md" },
      "postgresql": { "patterns": ["(?i)\\bSERIAL\\b", "::\\w+", "(?i)\\bRETURNING\\b"],
                      "standards": "rules/standards-postgresql.md" }
    },
    "vue": {
      "typescript": { "patterns": ["<script[^>]*\\blang\\s*=\\s*[\"']ts[\"']"],
                      "standards": "rules/standards-typescript.md" },
      "javascript": { "patterns": [], "default": true,
                      "standards": "rules/standards-javascript.md" }
    }
  }
}
